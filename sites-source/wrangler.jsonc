{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kiiya-cleaning-checker",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 非秘密設定のみ記載する。GOOGLE_CLIENT_SECRET / APP_ADMIN_USER_ID / APP_STAFF_USER_IDS /
  // Chatwork 連携シークレット等は wrangler secret put または Cloudflare Dashboard (Encrypted) で設定し、
  // vars には同名キーを記載しないこと。
  "vars": {
    "APP_ENV": "local"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kiiya-cleaning-checker-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "kiiya-cleaning-checker-bucket"
    }
  ],
  "env": {
    "staging": {
      "name": "kiiya-cleaning-checker-staging",
      "vars": {
        "APP_ENV": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kiiya-cleaning-checker-db-staging",
          "database_id": "00000000-0000-4000-8000-000000000000",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "kiiya-cleaning-checker-bucket-staging"
        }
      ]
    },
    "production": {
      "name": "kiiya-cleaning-checker",
      "vars": {
        "APP_ENV": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kiiya-cleaning-checker-db",
          "database_id": "00000000-0000-4000-8000-000000000000",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "kiiya-cleaning-checker-bucket"
        }
      ]
    }
  }
}
